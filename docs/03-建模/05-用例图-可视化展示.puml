@startuml 05-用例图-可视化展示
title 可视化展示模块 用例图
left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F4F8FD
  BorderColor #4A6B8A
}

actor "值班员" as guard
actor "值班主管" as lead
actor "数据服务模块\n(接口)" as api

rectangle "可视化展示模块（web/）" {
  usecase "UC-14 查看实时客流" as UC14
  usecase "UC-15 按线路筛选" as UC15
  usecase "UC-16 查看趋势与排行" as UC16
  usecase "UC-17 接收客流告警" as UC17
  usecase "UC-18 感知断线与恢复" as UC18
}

guard --> UC14
guard --> UC17
lead --> UC16

UC15 .> UC14 : <<extend>>
UC14 ..> UC17 : <<include>>
UC14 ..> UC18 : <<include>>

UC14 --> api : GET /api/snapshot
UC16 --> api : GET /api/series、/api/rank
@enduml
