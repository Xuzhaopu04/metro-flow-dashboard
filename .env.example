# 复制成 .env 再改；.env 不进仓库（.gitignore 已排除）
# docker compose 会自动读取同目录的 .env

DJANGO_SECRET_KEY=dev-only-change-me
# 1 = 开发：报错页带堆栈，方便定位，但 404/500 返回 Django 的 HTML 页
# 0 = 演示/验收：错误统一走契约第 1 节规定的 {"error": {"code", "message"}}
#     handler404/handler500 只在 DEBUG=0 时生效，交付前请确认用的是 0
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL：本地开发用容器时保持默认即可，公网部署务必改掉
MYSQL_DB=metro
MYSQL_USER=root
MYSQL_PASSWORD=metro_dev_pwd
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Redis 与实时计算参数（采集端、计算端、接口端共用这几个变量名）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
EVENT_STREAM=gate_events
CONSUMER_GROUP=metric_builder
SNAPSHOT_KEY=metric:snapshot
WINDOW_SECONDS=1
SNAPSHOT_TTL=5
LATE_TOLERANCE_WINDOWS=2

# 告警阈值：单窗口全网客流达到或超过该值即告警，由服务端判定并写进 /api/snapshot。
# 演示时想看到告警横幅，把这个值调低（比如 5）比等真实客流涨上去快得多。
ALERT_THRESHOLD=100
