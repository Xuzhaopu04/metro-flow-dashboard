# 复制成 .env 再改；.env 不进仓库（.gitignore 已排除）
# docker compose 会自动读取同目录的 .env

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL：本地开发用容器时保持默认即可，公网部署务必改掉
MYSQL_DB=metro
MYSQL_USER=root
MYSQL_PASSWORD=metro_dev_pwd
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Redis 与实时计算参数（采集端、计算端、接口端共用这几个变量名）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
EVENT_STREAM=gate_events
CONSUMER_GROUP=metric_builder
SNAPSHOT_KEY=metric:snapshot
WINDOW_SECONDS=1
SNAPSHOT_TTL=5
LATE_TOLERANCE_WINDOWS=2

# 单窗口客流告警阈值（人次/秒）。改这里即可，不用改代码；
# 非整数或小于 1 会回退为 100 并打一条告警日志
ALERT_THRESHOLD=100
